# ─── Indispensables ──────────────────────────────────────────────────────────
# URI MongoDB Atlas, nom de base inclus (…mongodb.net/vennora)
DATABASE_URL=mongodb+srv://utilisateur:motdepasse@cluster.xxxxx.mongodb.net/vennora
# Au moins 32 caractères : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Adresse publique de l'interface (liens des QR codes et des e-mails).
# APP_URL=http://localhost:5173
# API_PORT=4000

# ─── Stockage des fichiers ───────────────────────────────────────────────────
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_REGION=eu-west-3
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ─── Rédaction assistée et transcription ─────────────────────────────────────
AI_PROVIDER=mock
TRANSCRIPTION_PROVIDER=mock
# AI_PROVIDER=groq
# TRANSCRIPTION_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.6-27b
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ─── E-mail ──────────────────────────────────────────────────────────────────
MAIL_DRIVER=console
# MAIL_DRIVER=smtp
# MAIL_FROM=Vennora <ne-pas-repondre@vennora.app>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=
