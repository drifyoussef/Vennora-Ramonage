{
  "name": "vennora",
  "version": "0.1.0",
  "private": true,
  "description": "Vennora Ramonage — gestion des interventions techniques. Back : Node.js + Fastify (back/). Front : React + TSX (front/). Code commun : shared/.",
  "workspaces": [
    "back",
    "front",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n back,front -c cyan,magenta \"npm run dev -w @vennora/back\" \"npm run dev -w @vennora/front\"",
    "build": "npm run build -w @vennora/front",
    "start": "npm run start -w @vennora/back",
    "typecheck": "npm run typecheck -w @vennora/shared -w @vennora/back -w @vennora/front",
    "lint": "npm run lint -w @vennora/shared -w @vennora/back -w @vennora/front",
    "test": "npm run test -w @vennora/back",
    "test:watch": "npm run test:watch -w @vennora/back",
    "db:seed": "npm run db:seed -w @vennora/back",
    "db:indexes": "npm run db:indexes -w @vennora/back",
    "org:create": "npm run org:create -w @vennora/back --",
    "org:plan": "npm run org:plan -w @vennora/back --",
    "user:password": "npm run user:password -w @vennora/back --"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
