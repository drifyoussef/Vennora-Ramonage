{
  "name": "vennora",
  "version": "0.1.0",
  "private": true,
  "description": "Vennora Ramonage — gestion des interventions techniques. API Fastify (apps/api), interface React (apps/web), métier partagé (packages/core).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @vennora/web",
    "start": "npm run start -w @vennora/api",
    "typecheck": "npm run typecheck -w @vennora/core -w @vennora/api -w @vennora/web",
    "lint": "eslint .",
    "test": "npm run test -w @vennora/api",
    "test:watch": "npm run test:watch -w @vennora/api",
    "db:seed": "npm run db:seed -w @vennora/api",
    "db:indexes": "npm run db:indexes -w @vennora/api",
    "org:create": "npm run org:create -w @vennora/api --",
    "org:plan": "npm run org:plan -w @vennora/api --",
    "user:password": "npm run user:password -w @vennora/api --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^14.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2"
  }
}
